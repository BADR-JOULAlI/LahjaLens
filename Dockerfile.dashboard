FROM python:3.11-slim

WORKDIR /opt/lahjalens
COPY requirements-dashboard.txt /tmp/requirements-dashboard.txt
RUN pip install --no-cache-dir -r /tmp/requirements-dashboard.txt
COPY apps /opt/lahjalens/apps

EXPOSE 8501
CMD ["streamlit", "run", "/opt/lahjalens/apps/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501"]
