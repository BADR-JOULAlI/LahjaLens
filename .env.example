# === Spark Cluster (Cluster Docker ou Local) ===
# Utiliser "spark://localhost:7077" pour le cluster Docker, ou "local[*]" pour vos tests légers
SPARK_MASTER_URL=spark://localhost:7077

# === Configuration Data Lake HDFS ===
HDFS_NAMENODE_URL=hdfs://localhost:9000
HDFS_REPLICATION=2
HDFS_BRONZE_PATH=/data/lahjalens/bronze/comments/
HDFS_SILVER_PATH=/data/lahjalens/silver/comments/
HDFS_GOLD_PATH=/data/lahjalens/gold/sentiment/

# === Kafka Broker (Mode KRaft) ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_COMMENTS_RAW=comments.raw

# === Base de données PostgreSQL ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lahjalens_db
POSTGRES_USER=lahja_user
POSTGRES_PASSWORD=change_me

# === MLflow Tracking Server ===
MLFLOW_TRACKING_URI=http://localhost:5000